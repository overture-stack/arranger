{
	"$schema": "https://json.schemastore.org/tsconfig",
	"compilerOptions": {
		"declaration": true,
		"declarationMap": false,
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"noImplicitAny": true,
		"noImplicitReturns": true,
		"noUncheckedIndexedAccess": true,
		"outDir": "./dist",
		"paths": {
			"#*": ["./src/*"],
			// IDE-only: lets VS Code's IntelliSense see live sqon source without a rebuild.
			// tsconfig.release.json resets this back to the entry above, so the real build
			// (and this package's watch script, which runs against tsconfig.release.json) is unaffected.
			"@overture-stack/sqon": ["../sqon/src/index.ts"]
		},
		"plugins": [
			{
				"transform": "typescript-transform-paths"
			},
			{
				"transform": "typescript-transform-paths",
				"afterDeclarations": true
			}
		],
		// rootDir is intentionally NOT "./src" here: the sqon source alias above pulls files in
		// from outside src/, which a hard rootDir rejects (TS6059). tsconfig.release.json sets
		// rootDir: "./src" explicitly, since its paths reset means that constraint is safe there.
		"rootDir": "../..",
		"strict": true,
		"types": ["node"],
		"verbatimModuleSyntax": true
	},
	"exclude": ["dist/**/*"],
	"extends": "@tsconfig/node22/tsconfig.json",
	"include": ["src/**/*"]
}

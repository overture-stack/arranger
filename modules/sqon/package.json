{
	"name": "@overture-stack/sqon",
	"description": "Shared SQON schema and types for Overture services (see README: no stable release yet, use the rc dist-tag)",
	"version": "0.0.0-dev",
	"homepage": "https://github.com/overture-stack/arranger#readme",
	"bugs": {
		"url": "https://github.com/overture-stack/arranger/issues"
	},
	"repository": {
		"directory": "modules/sqon",
		"type": "git",
		"url": "git+https://github.com/overture-stack/arranger.git"
	},
	"main": "dist/index.cjs",
	"types": "dist/index.d.ts",
	"sideEffects": false,
	"exports": {
		".": {
			"import": "./dist/index.js",
			"require": "./dist/index.cjs",
			"types": "./dist/index.d.ts"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "wireit",
		"clear:dist": "rm -rf dist",
		"generateVersion": "node scripts/generateVersion.mjs",
		"patchTS": "ts-patch install -s",
		"prebuild": "npm run generateVersion",
		"prepare": "npm run patchTS",
		"pretest": "npm run generateVersion",
		"test": "tsx --test",
		"test:watch": "npm test -- --watch",
		"watch": "WIREIT_WATCH=true npm run build"
	},
	"dependencies": {
		"zod": "^3.24.2",
		"zod-to-json-schema": "^3.24.1"
	},
	"devDependencies": {
		"@tsconfig/node22": "^22.0.0",
		"@types/node": "^22.19.13",
		"ts-patch": "^3.3.0",
		"tsup": "^6.7.0",
		"tsx": "^4.19.2",
		"typescript": "^5.8.2",
		"typescript-transform-paths": "^3.5.6"
	},
	"imports": {
		"#*": "./src/*"
	},
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"wireit": {
		"build": {
			"command": "tsup",
			"files": [
				"src/**/*.ts",
				"!src/version/generated.ts"
			],
			"output": [
				"dist/**"
			]
		}
	}
}

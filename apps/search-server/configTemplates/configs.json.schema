// this file serves as an example of one catalogue's Arranger configuration, as the server holds it
// once it has merged every .json file in that catalogue's folder (base.json, extended.json, ...),
// and it shows both required (marked with *) and optional properties
// in a multicatalogue setup, each catalogue has a folder of its own under CONFIGS_PATH, named after
// its catalogue id, holding its own files, so every value here, "auth" included, is set per catalogue
// note: credentials in config json files will be ignored

{
	// Optional catalog identifier. Defaults to folder name if omitted.
	"catalogId": "file-catalog-1",

	// Optional human-readable description of this catalogue. Included in the /introspection response
	// and surfaced to MCP clients and other consumers of the introspection API.
	"description": "Clinical files and associated metadata for the study.",

	// GraphQL root query property, labels the type of records found by Arranger
*	"documentType": "file",

	// Index name or alias in Elasticsearch/OpenSearch
*	"esIndex": "file_centric_1.0",

	// Optional. For a data source whose documents wrap all their real content inside one
	// top-level property (e.g. a Lyric-sourced catalogue, nested under "data"): unwraps the
	// mapping and every query/response at that path, so extended.json/facets.json/table.json
	// can still use clean, unprefixed field names. A dotted path (e.g. "envelope.payload")
	// walks down through that many levels. A configured value that doesn't match the real
	// mapping fails the catalogue at startup rather than silently ignoring it. See
	// docs/reference/01-arranger-configs.md for full detail, including caveats.
	"nestingPrefix": "data",

	///////////// Feature flags /////////////

	"disableDownloads": false,
	"disableFilters": false,
	"disableGraphQLIntrospection": false,
	"disablePlayground": false,
	"enableGraphQLBatching": false,
	"enableSets": false,

	///////////// Configuration for Features and Components /////////////

	// Settings and limits for dataset downloads - [Back-end]
	"downloads": {
		"allowCustomMaxRows": true,
		"maxRows": 10000,

		// Optional, false by default. Whether maxRows also bounds a request's own row limit, which then
		// applies only when it is smaller. The search server sets it to true on every catalogue while
		// ENABLE_ACCESS_ENFORCEMENT is true, whatever this file says.
		"maxRowsIsCeiling": false
	},

	// ES mapping customization, aka the Extended mapping
	"extended": [
		{
			"isActive": false,
			"displayName": "Analysis",
			"displayType": "object", // custom "default" for aggs and columns
			"displayValues": {},
			"fieldName": "analysis",
			"isArray": false,
			"primaryKey": false,
			"quickSearchEnabled": false,
			"rangeStep": 1,
			"unit": null,
			"type": "object" // from the ES mapping
		}
		// ...
	],

	// Facets component customization, aka the "filters" - [Front-end]
	"facets": {
		"aggregations": [
			{
				"isActive": true,
				"displayType": "keyword", // defaults to the field from extended
				"fieldName": "analysis__analysis_id",
				"show": true
			}
			// ...
		]
	},

	// Matchbox component customization, currently being reimplemented - [Front-end]
	"matchbox": [
		{
			"isActive": false,
			"displayName": "file",
			"fieldName": "",
			"keyFieldName": null,
			"searchFields": []
		}
		// ...
	],

	// Table component customization - [Front-end]
	"table": {
		"columns": [
			{
				"accessor": "analysis.analysis_id",
				"canChangeShow": true,
				"displayFormat": "", // used for formattable fields e.g. 'YY-MM-DD'
				"displayName": "Analysis ID",
				"displayType": "id", // useful to use a different Cell type. defaults to the field from extended
				"displayValues": "", // used for "readable" replacements e.g. true as "yes"
				"fieldName": "analysis.analysis_id",
				"isArray": false, // should it be displayed as a list of items, or leave as a single string
				"jsonPath": null,
				"query": null,
				"show": true,
				"sortable": true
			}
			// ...
		],
		"defaultSorting": [
			{
				"desc": false,
				"fieldName": "analysis.analysis_id"
			},
			...
		],
		"maxResultsWindow": 10000,
		"rowIdFieldName": "analysis.analysis_id"
	},

	///////////// Access control /////////////

	// The catalogue's access-control registration, used while ENABLE_ACCESS_ENFORCEMENT is true, when every
	// catalogue needs one. Unlike every other key in this file, "auth" is read from the catalogue's
	// auth.json alone and never merged from another file: startup is refused when any other file in the
	// catalogue's folder carries an "auth" key, or when auth.json holds anything but this one key,
	// whether ENABLE_ACCESS_ENFORCEMENT is on or off.
	// See docs/reference/07-feature-flags.md#with-access-enforcement-on
	"auth": {
		// Optional. Global categories no record of this catalogue can carry, declared rather than
		// defined, so none of them also appears in categories.global.
		"absentCategories": ["global.restricted"],

		// Each category a record can carry, as the SQON condition a record meets to carry it. A record
		// carries every category whose condition it matches; one matching none is unmarked, which is
		// never defined here. A condition reads keyword, date or numeric fields outside any nested
		// field, lists literal values, and uses no wildcard, exclusion operator, "all" or pivot: exclude
		// a value with a "not" around an "in". modules/usher-adapter/README.md lists every rule.
*		"categories": {
			// Categories the whole platform shares, each named "global.<name>"; {} when none is defined.
*			"global": {
				"global.controlled": { "content": { "fieldName": "data_category", "value": ["controlled"] }, "op": "in" }
			},

			// Optional. Categories that exist only in one resource, by resource and then by name, each
			// named "resource.<name>" and never "resource.unmarked".
			"resource": {
				"STUDY-1": {
					"resource.embargoed": { "content": { "fieldName": "release_state", "value": ["embargoed"] }, "op": "in" }
				}
			}
		},

		// "record" for a catalogue whose records each belong to a resource and carry categories, or
		// "open" for one served to every request, whose "auth" is then { "kind": "open" } and nothing else.
*		"kind": "record",

		// The field holding the resource each record belongs to, such as a study or a program: a keyword
		// field outside any nested field, holding one value per record, named as the other config files
		// name fields (unprefixed under nestingPrefix). No condition reads it.
*		"resourceFieldName": "study_id",

		// Optional. Every resource this catalogue holds; when given, it lists each resource defining
		// categories of its own. An empty list denies every request.
		"resources": ["STUDY-1", "STUDY-2"]
	},

	///////////// Currently in development /////////////

	// Network Search Configuration
	"network": {
		// Customize all requests to remote nodes
		"remoteRequests": {

			// Include headers from query request in requests to all remote nodes.
			"headers": ["Authorization"]
		},

		// List of remote notes to include in network aggregation search
		"remoteNodes": [
			{
				"graphqlUrl": "http://localhost:5051/graphql",
				"documentType": "file",
				"displayName": "Local Port 5051",
				"nodeId": "local-5051"

				// Customize requests to this specific remote node
				"requests": {

					// Include headers from query request in requests to this remote node.
					// Overwrites network.remoteRequests.headers value for this node only.
					"headers": ["Authorization"]
				}
			}
		],

		// Optionally, include the local catalog in the network aggregation search
		"localNode": { "displayName": "Local Port 5050", "nodeId": "local-5050" }
	},

	// Charts Visualizations library
	"charts": {
		"query": "query chartsQeury($filters: JSON) {\n
			file {\n
				aggregations(
					filters: $filters,
					aggregations_filter_themselves: true
				) {\n
					study_id {\n
						bucket_count\n
						buckets {\n
							doc_count\n
							key\n
						}\n
					}\n
					primary_diagnosis__age_at_diagnosis {\n
						range(ranges: [\n
							{ key: \"Less than 18\", to: 18 },\n
							{ key: \"18 to 65\", from: 18, to: 66 },\n
							{ key: \"65 and above\", from: 65 }\n
						]) {\n
							buckets {\n
								key\n
								doc_count\n
							}\n
						}\n
					}\n
				}\n
			}\n
		}",
	}
}
